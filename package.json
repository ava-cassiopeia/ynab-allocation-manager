{
  "name": "ynab-allocation-manager",
  "version": "0.16.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:ng": "firebase emulators:exec 'ng test --browsers ChromeHeadless --watch false'",
    "test:fn": "firebase emulators:exec 'npm run --prefix functions test'",
    "test": "npm run test:ng && npm run test:fn",
    "emulate": "npm --prefix functions run build && dotenv -e .env.dev -- firebase emulators:start",
    "format": "gts fix",
    "lint": "gts lint",
    "clean": "gts clean",
    "fix": "gts fix"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "firebase": "^11.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ynab": "^2.9.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@dotenvx/dotenvx": "^1.44.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.7.5",
    "baseline-browser-mapping": "^2.10.33",
    "dotenv-cli": "^8.0.0",
    "gts": "^7.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
